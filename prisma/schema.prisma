generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(CUSTOMER)
  gender    Gender?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointmentsCustomer Appointment[]       @relation("CustomerAppointments")
  appointmentsStaff    Appointment[]       @relation("StaffAppointments")
  availabilities       StaffAvailability[]
  staffServices        StaffService[]      @relation("StaffUserServices")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Service {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  durationMinutes Int
  price           Float
  image            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staff            StaffService[]
  appointmentLinks AppointmentService[]
}

model StaffService {
  yid       Int     @id @default(autoincrement())
  staff     User    @relation("StaffUserServices", fields: [staffId], references: [id])
  staffId   Int
  service   Service @relation(fields: [serviceId], references: [id])
  serviceId Int
}

model Appointment {
  id              Int               @id @default(autoincrement())
  customer        User              @relation("CustomerAppointments", fields: [customerId], references: [id])
  customerId      Int
  staff           User              @relation("StaffAppointments", fields: [staffId], references: [id])
  staffId         Int
  appointmentDate DateTime
  startTime       DateTime
  endTime         DateTime
  status          AppointmentStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  services AppointmentService[]
  payment  Payment?
  review   Review?
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model AppointmentService {
  id              Int         @id @default(autoincrement())
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  appointmentId   Int
  service         Service     @relation(fields: [serviceId], references: [id])
  serviceId       Int
  price           Float
  durationMinutes Int
}

model StaffAvailability {
  id        Int       @id @default(autoincrement())
  staff     User      @relation(fields: [staffId], references: [id])
  staffId   Int
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Payment {
  id            Int           @id @default(autoincrement())
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  appointmentId Int           @unique
  amount        Float
  method        PaymentMethod @default(CASH)
  status        PaymentStatus @default(PENDING)
  transactionId String?
  createdAt     DateTime      @default(now())
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Review {
  id            Int         @id @default(autoincrement())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  appointmentId Int         @unique
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
}